FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY app/backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY app/backend /app
COPY docker/backend/entrypoint.sh /usr/local/bin/moonlogistics-entrypoint
RUN chmod +x /usr/local/bin/moonlogistics-entrypoint

EXPOSE 8000

ENTRYPOINT ["moonlogistics-entrypoint"]
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "--access-logfile", "-", "config.wsgi:application"]
